{
  "name": "ten-charms",
  "version": "1.0.0",
  "private": true,
  "description": "A cozy Rose Garden rummy card game for iPhone.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "preview": "node scripts/build.mjs && node scripts/serve.mjs dist 4173",
    "serve": "node scripts/serve.mjs dist 4173",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "sim": "node scripts/simulate.ts",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.2.5",
    "@fontsource/nunito": "^5.2.5",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "sharp": "^0.34.0",
    "typescript": "^5.9.0"
  }
}
